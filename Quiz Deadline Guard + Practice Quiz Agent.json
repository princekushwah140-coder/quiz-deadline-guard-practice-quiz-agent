      "credentials": {
        "gmailOAuth2": {
          "id": "QLZyVaHvtXj0nZxs",
          "name": "Gmail account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const mails = $input.all().map(i => {\n  const j = i.json;\n  return `From: ${j.From || ''}\\nSubject: ${j.Subject || ''}\\nSnippet: ${(j.snippet || '').slice(0, 500)}`;\n}).join('\\n---\\n');\nreturn [{ json: { mails } }];"
      },
      "id": "6e48f14f-d61e-41a6-8472-954b39e35389",
      "name": "Build Email Digest Text",
      "type": "n8n-nodes-base.code",
      "position": [
        -1072,
        304
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Below are recent emails. List ONLY those announcing a quiz, test, assessment, or assignment deadline.\nFormat each as one line: Title | Date/Time | Link or platform.\nIf none are relevant, reply with exactly: NONE\n\nEmails:\n{{ $json.mails }}"
      },
      "id": "f7828887-3c56-4052-87d0-db3160876eb4",
      "name": "Extract Quiz Details",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
